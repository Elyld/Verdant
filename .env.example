# Copy to `.env` and fill in what you use. Verdant runs fine with none of these set —
# `docker compose up -d` on its own gives you a working garden journal.

# Host port for the web UI.
GARDEN_PORT=3113

# Public URL of this server (used to resolve relative URLs in "Import from URL").
# Set to your real address, e.g. https://photos.yourdomain.com
GARDEN_PUBLIC_URL=http://localhost:3113

# Immich integration (optional) — enables the "Import from Immich" section.
# IMMICH_BASE_URL: your Immich server URL. If Verdant runs in Docker on the
# same machine as Immich, use host.docker.internal so the container can
# reach back to your host, e.g. http://host.docker.internal:2283
# IMMICH_API_KEY: <redacted>
# (needs album.read, asset.read, metadata.read).
IMMICH_BASE_URL=
IMMICH_API_KEY=<redacted>

# Garden location (optional) — stamps each new observation with the current
# weather (free Open-Meteo data, no key needed). Find your coordinates at
# https://open-meteo.com by clicking your spot on the map.
GARDEN_LAT=
GARDEN_LON=

# Morning garden digest -> Discord (optional, off by default).
# Easiest: set it on the /settings page in the web UI (applies immediately).
# Or use env vars: set DIGEST_ENABLED=true and paste the webhook URL below.
# Verdant sends a "morning garden check" (overdue / due today / coming up)
# every day at DIGEST_TIME (24h HH:MM, server local time). Leave DIGEST_ENABLED
# unset or false to keep it off.
# 1. In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook,
#    pick a channel, then "Copy Webhook URL".
DIGEST_ENABLED=false
DISCORD_WEBHOOK_URL=
DIGEST_TIME=08:00

# Seed-starting calendar (optional) — your average last spring frost date
# (YYYY-MM-DD). Verdant suggests indoor-start dates for each plant from this.
# Easiest: pick your USDA zone on the /settings page and Verdant fills in an
# approximate date automatically; set an exact date there to override it.
# Look yours up via your local extension office or https://planthardiness.ars.usda.gov
LAST_FROST_DATE=

# Frost countdown (optional) — your average first fall frost date (YYYY-MM-DD).
# Verdant shows a small "days to first frost" countdown in the header.
# Same deal: set your USDA zone on the /settings page for an automatic
# approximate date, or set an exact date there to override this.
FIRST_FROST_DATE=
